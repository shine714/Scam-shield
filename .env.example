# ScamShield AI Backend Configuration
# Copy this file to .env and add your real API keys.
# NEVER commit .env or put API keys in frontend VITE_* variables.

# Phase 2: Message Scam Detection (Gemini AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Phase 3: Optional External URL Reputation Lookup (Google Safe Browsing API v4)
# Leave blank to run local structural URL heuristics only.
GOOGLE_SAFE_BROWSING_API_KEY=

PORT=3001
